{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "packages/frontend/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{packages/backend/dist/**,packages/backend/prisma/**,node_modules/.prisma/**,node_modules/@prisma/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
