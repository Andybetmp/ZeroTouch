generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StayType {
  PERMANENTE_CIA
  TEMPORAL
  VISITA_TECNICA
  VISITA_COMERCIAL
}

enum JobPosition {
  OPERARIO
  TECNICO
  INGENIERO
  CONDUCTOR
  PERSONAL_COCINA
  OTROS
}

enum AccessZone {
  SUPERFICIE
  SOCAVON
  PLANTA_CONCENTRADORA
  OFICINAS_ADMINISTRATIVAS
}

enum ResponsibleArea {
  AREA_USUARIA
  SSOMA
  AREA_MEDICA
  DHO
}

enum TrafficLightStatus {
  VERDE
  AMBAR
  ROJO
}

enum DocumentStatus {
  PENDIENTE
  VERDE
  AMBAR
  ROJO
}

enum ExceptionStatus {
  OPEN
  APPROVED
  REJECTED
}

enum PvcPrintStatus {
  QUEUED_GARITA
  PRINTED
  DELIVERED
}

enum Role {
  SSOMA
  ECM
  GARITA
  TRABAJADOR
}

enum TrainingModality {
  ELEARNING
  PRESENTIAL
  VR
}

enum BiometricSessionType {
  LOGIN
  PROCTORING
}

enum ExternalProviderType {
  CLINIC_EMO
  SCTR_SALUD
  SCTR_PENSION
  VIDA_LEY
}

model ContractorEcm {
  id          String   @id @default(uuid()) @db.Uuid
  ruc         String   @unique @db.VarChar(11)
  companyName String   @map("company_name") @db.VarChar(150)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  workers     Worker[]

  @@map("contractors_ecm")
}

model BlacklistEntry {
  id        String   @id @default(uuid()) @db.Uuid
  dni       String   @unique @db.VarChar(15)
  fullName  String   @map("full_name") @db.VarChar(150)
  reason    String   @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blacklist_entries")
}

model StayTypeRequirement {
  id               String           @id @default(uuid()) @db.Uuid
  code             String           @unique @db.VarChar(40)
  name             String           @db.VarChar(150)
  stayType         StayType         @map("stay_type")
  applicableJob    JobPosition?     @map("applicable_job")
  isMandatory      Boolean          @default(true) @map("is_mandatory")
  requiresValidity Boolean          @default(false) @map("requires_validity")
  responsibleArea  ResponsibleArea  @map("responsible_area")
  createdAt        DateTime         @default(now()) @map("created_at")
  workerDocuments  WorkerDocument[]

  @@map("stay_type_requirements")
}

model Worker {
  id                 String                      @id @default(uuid()) @db.Uuid
  dni                String                      @unique @db.VarChar(15)
  fullName           String                      @map("full_name") @db.VarChar(150)
  photoUrl           String?                     @map("photo_url") @db.Text
  contractorId       String                      @map("contractor_id") @db.Uuid
  contractor         ContractorEcm               @relation(fields: [contractorId], references: [id])
  jobPosition        JobPosition                 @map("job_position")
  stayType           StayType                    @default(PERMANENTE_CIA) @map("stay_type")
  accessZone         AccessZone                  @default(SUPERFICIE) @map("access_zone")
  trafficLight       TrafficLightStatus          @default(AMBAR) @map("traffic_light")
  statusSummary      String                      @map("status_summary") @db.VarChar(255)
  isBlacklisted      Boolean                     @default(false) @map("is_blacklisted")
  elearningPassed    Boolean                     @default(false) @map("elearning_passed")
  sessionCode        String                      @map("session_code") @db.VarChar(20)
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  documents          WorkerDocument[]
  elearningAttempts  ElearningAttempt[]
  digitalBadge       DigitalBadgeQr?
  auditLogs          AuditLog[]
  users              User[]
  trainingProgress   WorkerTrainingProgress[]
  biometricLogs      BiometricAuditLog[]
  integrationRecords ExternalIntegrationRecord[]
  vrSessions         VrSimulationSession[]
  courseAssignments  WorkerCourseAssignment[]
  cvProfile          WorkerCvProfile?
  certificates       TrainingCertificate[]

  @@map("workers")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(TRABAJADOR)
  fullName     String   @map("full_name") @db.VarChar(150)
  areaLabel    String   @default("Portal del Trabajador") @map("area_label") @db.VarChar(150)
  workerId     String?  @map("worker_id") @db.Uuid
  worker       Worker?  @relation(fields: [workerId], references: [id], onDelete: SetNull)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

enum CourseResourceType {
  VIDEO
  PDF
  PRESENTATION
  QUIZ
}

enum CourseModality {
  VIRTUAL
  PRESENCIAL
}

model TrainingCourse {
  id            String                   @id @default(uuid()) @db.Uuid
  code          String                   @unique @db.VarChar(40)
  title         String                   @db.VarChar(180)
  description   String                   @db.Text
  dayNumber     Int                      @default(1) @map("day_number") // 1..4
  modality      CourseModality           @default(VIRTUAL)
  durationHours Float                    @default(2.0) @map("duration_hours")
  totalHours    Int                      @default(32) @map("total_hours")
  minPassScore  Int                      @default(75) @map("min_pass_score")
  maxAttempts   Int                      @default(3) @map("max_attempts")
  jobSpecialty  JobPosition?             @map("job_specialty")
  targetArea    AccessZone?              @map("target_area") // null = Etapa 1 (Inducción General), valor = Etapa 2 (Específico del Área)
  orderIndex    Int                      @default(1) @map("order_index")
  isActive      Boolean                  @default(true) @map("is_active")
  createdAt     DateTime                 @default(now()) @map("created_at")
  modules       TrainingModule[]
  resources     TrainingResource[]
  questions     TrainingQuestion[]
  assignments   WorkerCourseAssignment[]

  @@map("training_courses")
}

model TrainingResource {
  id              String             @id @default(uuid()) @db.Uuid
  courseId        String             @map("course_id") @db.Uuid
  course          TrainingCourse     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type            CourseResourceType @default(VIDEO)
  title           String             @db.VarChar(180)
  fileUrl         String?            @map("file_url") @db.Text
  fileName        String?            @map("file_name") @db.VarChar(255)
  durationMinutes Int                @default(30) @map("duration_minutes")
  orderIndex      Int                @default(1) @map("order_index")
  createdAt       DateTime           @default(now()) @map("created_at")

  @@map("training_resources")
}

model TrainingModule {
  id            String                   @id @default(uuid()) @db.Uuid
  courseId      String                   @map("course_id") @db.Uuid
  course        TrainingCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code          String                   @unique @db.VarChar(50)
  title         String                   @db.VarChar(180)
  description   String                   @db.Text
  videoUrl      String?                  @map("video_url") @db.Text
  dayNumber     Int                      @map("day_number") // 1..4
  modality      TrainingModality         @default(ELEARNING)
  requiredHours Int                      @default(8) @map("required_hours")
  jobSpecialty  JobPosition?             @map("job_specialty") // null = transversal a todos los puestos
  orderIndex    Int                      @default(1) @map("order_index")
  isActive      Boolean                  @default(true) @map("is_active")
  createdAt     DateTime                 @default(now()) @map("created_at")
  questions     TrainingQuestion[]
  progress      WorkerTrainingProgress[]
  biometricLogs BiometricAuditLog[]

  @@map("training_modules")
}

model TrainingQuestion {
  id           String          @id @default(uuid()) @db.Uuid
  moduleId     String?         @map("module_id") @db.Uuid
  module       TrainingModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courseId     String?         @map("course_id") @db.Uuid
  course       TrainingCourse? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questionText String          @map("question_text") @db.Text
  optionsJson  String          @map("options_json") @db.Text
  correctIndex Int             @map("correct_index")
  points       Int             @default(25)
  isActive     Boolean         @default(true) @map("is_active")

  @@map("training_questions")
}

model WorkerCourseAssignment {
  id              String         @id @default(uuid()) @db.Uuid
  workerId        String         @map("worker_id") @db.Uuid
  worker          Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  courseId        String         @map("course_id") @db.Uuid
  course          TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status          String         @default("PENDING") @db.VarChar(30) // PENDING, IN_PROGRESS, COMPLETED, FAILED
  progressPercent Int            @default(0) @map("progress_percent")
  watchedSeconds  Int            @default(0) @map("watched_seconds")
  hoursCompleted  Float          @default(0) @map("hours_completed")
  examScore       Int?           @map("exam_score")
  attemptsUsed    Int            @default(0) @map("attempts_used")
  instructorName  String?        @map("instructor_name") @db.VarChar(120)
  attendanceDate  String?        @map("attendance_date") @db.VarChar(40)
  notes           String?        @db.Text
  completedAt     DateTime?      @map("completed_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([workerId, courseId])
  @@map("worker_course_assignments")
}

model WorkerCvProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  workerId             String   @unique @map("worker_id") @db.Uuid
  worker               Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  pdfFileName          String?  @map("pdf_file_name") @db.VarChar(255)
  pdfUrl               String?  @map("pdf_url") @db.Text
  educationJson        String   @default("[]") @map("education_json") @db.Text
  workExperienceJson   String   @default("[]") @map("work_experience_json") @db.Text
  miningExperienceJson String   @default("[]") @map("mining_experience_json") @db.Text
  specializationsJson  String   @default("[]") @map("specializations_json") @db.Text
  certificationsJson   String   @default("[]") @map("certifications_json") @db.Text
  coursesJson          String   @default("[]") @map("courses_json") @db.Text
  updatedBy            String   @default("Sistema") @map("updated_by") @db.VarChar(120)
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("worker_cv_profiles")
}

model TrainingCertificate {
  id              String   @id @default(uuid()) @db.Uuid
  workerId        String   @map("worker_id") @db.Uuid
  worker          Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  certificateCode String   @unique @map("certificate_code") @db.VarChar(60)
  virtualHours    Float    @default(0) @map("virtual_hours")
  presentialHours Float    @default(0) @map("presential_hours")
  totalHours      Float    @default(0) @map("total_hours")
  averageScore    Float    @default(0) @map("average_score")
  issuedBy        String   @default("SSOMA Minera Bateas") @map("issued_by") @db.VarChar(120)
  issuedAt        DateTime @default(now()) @map("issued_at")

  @@map("training_certificates")
}

model WorkerTrainingProgress {
  id                   String         @id @default(uuid()) @db.Uuid
  workerId             String         @map("worker_id") @db.Uuid
  worker               Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  moduleId             String         @map("module_id") @db.Uuid
  module               TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  completedSeconds     Int            @default(0) @map("completed_seconds")
  requiredSeconds      Int            @default(28800) @map("required_seconds") // 8h = 28800s
  status               String         @default("PENDING") @db.VarChar(30) // PENDING, IN_PROGRESS, COMPLETED, FAILED
  examScore            Int?           @map("exam_score")
  scheduledDate        String?        @map("scheduled_date") @db.VarChar(40)
  scheduledShift       String?        @map("scheduled_shift") @db.VarChar(40)
  attendanceVerifiedBy String?        @map("attendance_verified_by") @db.VarChar(120)
  practicalScore       Int?           @map("practical_score") // 0-20 (min 14)
  observations         String?        @db.Text
  completedAt          DateTime?      @map("completed_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@unique([workerId, moduleId])
  @@map("worker_training_progress")
}

model BiometricAuditLog {
  id              String               @id @default(uuid()) @db.Uuid
  workerId        String               @map("worker_id") @db.Uuid
  worker          Worker               @relation(fields: [workerId], references: [id], onDelete: Cascade)
  sessionType     BiometricSessionType @map("session_type")
  eventType       String               @map("event_type") @db.VarChar(60) // VERIFIED_OK, NO_FACE_DETECTED, MULTIPLE_FACES, IDENTITY_MISMATCH, CAMERA_BLOCKED_OR_DENIED
  confidenceScore Float                @default(0) @map("confidence_score")
  details         String?              @db.Text
  moduleId        String?              @map("module_id") @db.Uuid
  module          TrainingModule?      @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now()) @map("created_at")

  @@map("biometric_audit_logs")
}

model ExternalIntegrationRecord {
  id             String               @id @default(uuid()) @db.Uuid
  workerId       String               @map("worker_id") @db.Uuid
  worker         Worker               @relation(fields: [workerId], references: [id], onDelete: Cascade)
  providerType   ExternalProviderType @map("provider_type")
  providerName   String               @map("provider_name") @db.VarChar(150)
  status         String               @db.VarChar(40) // APTO, APTO_CON_RESTRICCIONES, NO_APTO, ACTIVA, VENCIDA, SUSPENDIDA
  restrictions   String?              @db.Text
  policyNumber   String?              @map("policy_number") @db.VarChar(80)
  expiresAt      DateTime             @map("expires_at") @db.Date
  lastSyncedAt   DateTime             @default(now()) @map("last_synced_at")
  rawPayloadJson String?              @map("raw_payload_json") @db.Text

  @@unique([workerId, providerType])
  @@map("external_integration_records")
}

model VrSimulationSession {
  id                 String    @id @default(uuid()) @db.Uuid
  workerId           String    @map("worker_id") @db.Uuid
  worker             Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  pairingCode        String?   @map("pairing_code") @db.VarChar(12)
  scenarioCode       String    @map("scenario_code") @db.VarChar(50) // SCALING_ROCK, GAS_VENTILATION, HEAVY_MACHINERY, LOTO_LOCKOUT
  score              Int       @default(0)
  criticalErrorsJson String    @default("[]") @map("critical_errors_json") @db.Text
  passed             Boolean   @default(false)
  durationSeconds    Int       @default(0) @map("duration_seconds")
  syncedToPractical  Boolean   @default(false) @map("synced_to_practical")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@map("vr_simulation_sessions")
}

model WorkerDocument {
  id                 String              @id @default(uuid()) @db.Uuid
  workerId           String              @map("worker_id") @db.Uuid
  worker             Worker              @relation(fields: [workerId], references: [id], onDelete: Cascade)
  requirementId      String              @map("requirement_id") @db.Uuid
  requirement        StayTypeRequirement @relation(fields: [requirementId], references: [id])
  fileName           String?             @map("file_name") @db.VarChar(255)
  fileMimeType       String?             @map("file_mime_type") @db.VarChar(80)
  fileHashSha256     String?             @map("file_hash_sha256") @db.VarChar(64)
  fileData           Bytes?              @map("file_data")
  extractedText      String?             @map("extracted_text") @db.Text
  extractionMethod   String?             @map("extraction_method") @db.VarChar(50)
  ocrConfidence      Float?              @map("ocr_confidence")
  detectedDni        String?             @map("detected_dni") @db.VarChar(15)
  detectedExpiryDate DateTime?           @map("detected_expiry_date") @db.Date
  status             DocumentStatus      @default(PENDIENTE)
  statusReason       String              @default("Pendiente de carga por la ECM") @map("status_reason") @db.VarChar(255)
  updatedAt          DateTime            @updatedAt @map("updated_at")
  exceptionReviews   ExceptionReview[]

  @@unique([workerId, requirementId])
  @@map("worker_documents")
}

model ExceptionReview {
  id               String          @id @default(uuid()) @db.Uuid
  workerDocumentId String          @map("worker_document_id") @db.Uuid
  workerDocument   WorkerDocument  @relation(fields: [workerDocumentId], references: [id], onDelete: Cascade)
  assignedArea     ResponsibleArea @map("assigned_area")
  reviewStatus     ExceptionStatus @default(OPEN) @map("review_status")
  reasonTriggered  String          @map("reason_triggered") @db.VarChar(255)
  reviewerName     String?         @map("reviewer_name") @db.VarChar(120)
  reviewerComment  String?         @map("reviewer_comment") @db.Text
  manualExpiryDate DateTime?       @map("manual_expiry_date") @db.Date
  createdAt        DateTime        @default(now()) @map("created_at")
  resolvedAt       DateTime?       @map("resolved_at")

  @@map("exception_reviews")
}

model QuizQuestion {
  id           String  @id @default(uuid()) @db.Uuid
  category     String  @db.VarChar(60)
  questionText String  @map("question_text") @db.Text
  optionsJson  String  @map("options_json") @db.Text
  correctIndex Int     @map("correct_index")
  isActive     Boolean @default(true) @map("is_active")

  @@map("quiz_questions")
}

model ElearningAttempt {
  id               String   @id @default(uuid()) @db.Uuid
  workerId         String   @map("worker_id") @db.Uuid
  worker           Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  materialReviewed Boolean  @default(false) @map("material_reviewed")
  scoreObtained    Int      @map("score_obtained")
  totalQuestions   Int      @map("total_questions")
  passed           Boolean
  certificateCode  String?  @map("certificate_code") @db.VarChar(60)
  attemptedAt      DateTime @default(now()) @map("attempted_at")

  @@map("elearning_attempts")
}

model DigitalBadgeQr {
  id             String         @id @default(uuid()) @db.Uuid
  workerId       String         @unique @map("worker_id") @db.Uuid
  worker         Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  badgeCode      String         @unique @map("badge_code") @db.VarChar(40)
  qrPayloadJson  String         @map("qr_payload_json") @db.Text
  signatureHash  String         @map("signature_hash") @db.VarChar(128)
  pvcPrintStatus PvcPrintStatus @default(QUEUED_GARITA) @map("pvc_print_status")
  issuedAt       DateTime       @default(now()) @map("issued_at")
  validUntil     DateTime       @map("valid_until") @db.Date

  @@map("digital_badges_qr")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  workerId  String?  @map("worker_id") @db.Uuid
  worker    Worker?  @relation(fields: [workerId], references: [id], onDelete: SetNull)
  actorArea String   @map("actor_area") @db.VarChar(60)
  action    String   @db.VarChar(100)
  details   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
