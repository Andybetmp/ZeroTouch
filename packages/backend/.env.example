# ============================================================================
# OPCIÓN 1: SUPABASE POSTGRESQL (Recomendado para Despliegue Cloud y MCP)
# Consíguelas en: Supabase Dashboard -> botón "Connect" -> pestaña "ORMs" -> "Prisma"
# ============================================================================
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[TU_PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[TU_PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ============================================================================
# OPCIÓN 2: POSTGRESQL LOCAL (Si usas tu servicio local postgresql-x64-18)
