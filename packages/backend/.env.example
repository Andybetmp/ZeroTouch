# ============================================================================
# DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/bateas_zerotouch?schema=public"
# DIRECT_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/bateas_zerotouch?schema=public"

PORT=4000
